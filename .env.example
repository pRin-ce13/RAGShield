# ==============================================================================
# RAGShield Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   copy .env.example .env (Windows)
#   cp .env.example .env (Linux/macOS)
#
# DO NOT commit real secrets, API keys, or credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_for_local_development

# Database Configuration (Used in Phase 7)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragshield_dev

# Background Tasks & Cache (Redis - Used in Phase 4)
REDIS_URL=redis://localhost:6379/0

# Demonstration Target RAG Application (Used in Phases 1 & 2)
DEMO_RAG_HOST=127.0.0.1
DEMO_RAG_PORT=8001
DEMO_RAG_API_KEY=demo_synthetic_insecure_key_for_testing

# Security Testing Engine Settings
MAX_CONCURRENT_REQUESTS=5
DEFAULT_REQUEST_TIMEOUT_SECONDS=10
ALLOWED_TARGET_DOMAINS=127.0.0.1,localhost

# Optional LLM-as-Judge API Key (Only used when deterministic evaluation is insufficient)
# Free / local alternatives (e.g. Ollama) will be supported as default.
LLM_PROVIDER=local
LLM_API_KEY=optional_api_key_placeholder
